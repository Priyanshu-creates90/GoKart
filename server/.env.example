# ==========================================
# GOKART SERVER ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to server/.env
# ==========================================

# Server Network Settings
PORT=8080
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080

# Dummy MongoDB Database (Set to your local MongoDB or Atlas URL)
# For local dummy database: mongodb://127.0.0.1:27017/gokart_dummy
MONGODB_URL=mongodb://127.0.0.1:27017/gokart_dummy

# Dummy Cloudinary Storage substitute (Set USE_DUMMY_STORAGE=false to use real Cloudinary)
CLOUDINARY_URL=cloudinary://dummy_key:dummy_secret@dummy_cloud
CLODINARY_CLOUD_NAME=dummy_cloud
CLODINARY_API_KEY=dummy_key
CLODINARY_API_SECRET_KEY=dummy_secret_key
USE_DUMMY_STORAGE=true
DUMMY_STORAGE_URL=http://localhost:8080/uploads

# JWT Authentication Secrets
SECRET_KEY_ACCESS_TOKEN=dummy_access_token_secret_gokart_2025_secure_key
SECRET_KEY_REFRESH_TOKEN=dummy_refresh_token_secret_gokart_2025_secure_key

# Payment & Email Services (Pre-set with working mock dummies)
STRIPE_SECRET_KEY=sk_test_dummy_stripe_secret_key_12345
STRIPE_ENPOINT_WEBHOOK_SECRET_KEY=whsec_dummy_webhook_secret_key_12345
SEND_GMAIL=dummy_email_app_password
EMAIL_USER=admin@gokart.com

# Gemini Assistant (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
